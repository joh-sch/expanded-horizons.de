# =============================================================================
# OS & editor
# =============================================================================

.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
*.code-workspace
*.sublime-project
*.sublime-workspace

# =============================================================================
# Node / Composer
# =============================================================================

node_modules/
build-utils/node_modules/
npm-debug.log*
yarn-error.log*

# =============================================================================
# Kirby — ignore runtime / installed files, track everything else
# =============================================================================

# Kirby core (installed via composer — run: npm run init-kirby)
development-site/vendor/
development-site/kirby/
development-site/composer.lock

# Kirby runtime (generated at runtime, never commit)
development-site/media/
development-site/storage/
development-site/site/cache/
development-site/site/sessions/

# Local environment config (copy config.localhost.php.example to get started)
development-site/site/config/config.localhost.php
development-site/.env

# Kirby accounts
development-site/site/accounts/

# =============================================================================
# Built assets (generated by npm run build / watch)
# =============================================================================

development-site/app/app.min.js
development-site/app/app.min.js.map
development-site/app/styles/styles.css

# =============================================================================
# Misc
# =============================================================================

TEMP/
