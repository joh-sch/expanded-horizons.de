{
  "name": "expanded-horizons",
  "version": "1.1.3",
  "private": true,
  "scripts": {
    "create-comp": "cd build-utils && npm run create-comp --",
    "init-project": "node build-utils/scripts/init-project.js",
    "init-kirby": "node build-utils/scripts/init-kirby.js",
    "updt-version": "node build-utils/scripts/updt-version.js",
    "release": "node tools/release/release.js",
    "tw-watch": "npx @tailwindcss/cli -i ./development-site/app/app.css -o ./development-site/app/styles/styles.css --watch",
    "tw-build": "npx @tailwindcss/cli -i ./development-site/app/app.css -o ./development-site/app/styles/styles.css -m",
    "js-watch": "NODE_ENV=development rollup -c rollup.config.mjs --watch",
    "js-build": "NODE_ENV=production rollup -c rollup.config.mjs",
    "watch": "npm run tw-watch & npm run js-watch",
    "build": "npm run tw-build && npm run js-build",
    "reload": "livereload . --wait 150"
  },
  "release": {
    "branch": "devel",
    "changelog": "CHANGELOG.md",
    "tempDir": "TEMP"
  },
  "dependencies": {
    "@swup/gia-plugin": "^2.0.4",
    "@tailwindcss/cli": "^4.3.0",
    "gia": "^1.0.1",
    "gsap": "^3.15.0",
    "regenerator-runtime": "^0.14.1",
    "swup": "^4.9.2",
    "tailwindcss": "^4.3.0",
    "vanilla-lazyload": "^19.1.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-eslint": "^9.2.0",
    "@rollup/plugin-inject": "^5.0.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "eslint": "^9.0.0",
    "livereload": "^0.10.3",
    "rollup": "^4.57.1"
  }
}
